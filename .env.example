# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase / PostgreSQL Connection String
# Option 1 - Local PostgreSQL (Local deployment with pgAdmin or Docker):
# postgresql://postgres:yourpassword@localhost:5432/bafa_db
# Option 2 - Supabase Transaction Pooler (recommended for serverless/Cloud Run):
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Option 3 - Direct Cloud PostgreSQL (Supabase / Aiven / Neon):
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

